# Absolute path to the local Git clone this process will manage
REPO_PATH=C:\Users\you\projects\my-repo

# GitHub repository events are accepted for (owner/name)
GITHUB_OWNER=your-github-username
GITHUB_REPO=my-repo

# How events are received:
#   runner  - GitHub Actions self-hosted runner + `npm run sync` (no inbound ports)
#   webhook - GitHub webhook + local HTTP server (optional tunnel)
#   both    - enable runner CLI and webhook server
SYNC_MODE=runner

# Required when SYNC_MODE is webhook or both (must match the GitHub webhook Secret)
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# Token used to list open PRs after a merge.
# - Webhook / local CLI: set a PAT here (classic repo / public_repo, or fine-grained Pull requests: Read)
# - Runner mode inside GitHub Actions: the workflow's GITHUB_TOKEN is used automatically
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HTTP port for the local webhook server (webhook / both only)
PORT=3000

# Only branches with this prefix are managed (Cursor default: cursor/)
BRANCH_PREFIX=cursor/

# Branch to land on when no other open feature PRs remain
BASE_BRANCH=main

# Cosmetic log label, e.g. [branch-sync] or [MOTL]
LOG_PREFIX=branch-sync
