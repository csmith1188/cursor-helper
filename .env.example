# Absolute path to the local Git clone this process will manage
REPO_PATH=C:\Users\you\projects\my-repo

# GitHub repository this webhook listens for (owner/name)
GITHUB_OWNER=your-github-username
GITHUB_REPO=my-repo

# Must match the "Secret" configured on the GitHub webhook
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# Personal access token with repo read access (needed to list open PRs)
# Classic: repo scope (or public_repo for public repos)
# Fine-grained: Pull requests (read) on this repository
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HTTP port for the local webhook server
PORT=3000

# Only branches with this prefix are managed (Cursor default: cursor/)
BRANCH_PREFIX=cursor/

# Branch to land on when no other open feature PRs remain
BASE_BRANCH=main

# Cosmetic log label, e.g. [branch-sync] or [MOTL]
LOG_PREFIX=branch-sync
